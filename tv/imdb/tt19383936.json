      "moviedb_id": 3980928
    },
    {
      "id": "tt19383936:1:2",
      "title": "Summer (August/September 1963)",
      "season": 1,
      "episode": 2,
      "number": 2,
      "released": "2022-10-07T00:00:00.000Z",
      "overview": "With the country's biggest beauty fair just around the corner, Axel enlists the help of Tove and Frans. Birthe's husband Jørgen is diagnosed with leukemia, which only an expensive new form of chemotherapy in Germany can cure.",
      "thumbnail": "https://episodes.metahub.space/tt19383936/1/2/w780.jpg",
      "moviedb_id": 3984770
    },
    {
      "id": "tt19383936:1:3",
      "title": "Summer/Fall (September 1963)",
      "season": 1,
      "episode": 3,
      "number": 3,
      "released": "2022-10-14T00:00:00.000Z",
      "overview": "The curler scandal at the beauty fair has gone around Denmark. Axel is out of business and now has 1000 defective curler sets that no one wants to buy. Birthe tries to raise money for Jørgen's chemotherapy.",
      "thumbnail": "https://episodes.metahub.space/tt19383936/1/3/w780.jpg",
      "moviedb_id": 3984771
    },
    {
      "id": "tt19383936:1:4",
      "title": "Fall (October 1963)",
      "season": 1,
      "episode": 4,
      "number": 4,
      "released": "2022-10-21T00:00:00.000Z",
      "overview": "Axel borrows a million kroner from the bank to build a factory that will produce Carmen Curlers for the whole world. Now he just needs the customers. But the rumor about the downturn from the beauty fair has spread throughout Denmark.",
      "thumbnail": "https://episodes.metahub.space/tt19383936/1/4/w780.jpg",
      "moviedb_id": 3984772
    },
    {
      "id": "tt19383936:1:5",
      "title": "Fall (November 1963)",
      "season": 1,
      "episode": 5,
      "number": 5,
      "released": "2022-10-28T00:00:00.000Z",
      "overview": "The Carmen Curlers factory opens, and Birthe has become HR manager. Axel looks forward to the Christmas sale cementing Carmen Curlers as an indispensable part of everyday life for all women in the Nordics.",
