  "videos": [
    {
      "id": "tt27657838:0:1",
      "title": "The Westward: Goodbye, Monkey King",
      "season": 0,
      "episode": 1,
      "number": 1,
      "released": "2020-05-04T00:00:00.000Z",
      "overview": "Princess Su Yi of the Heavenly Realm befriended Sun Wukong in the mortal world and fell in love with him. But Wukong was violently treated as a mortal demon by the other heavenly gods and suppressed under the Five Finger Mountain. For three hundred years, the Great God Rudrai used his actions to convert Wukong and teach him how to stand up for what is right in his heart. Sun Wukong protects Tang Sanzang and goes to the other side of the world to retrieve the Flame of Creation for the benefit of the world. After all the twists and turns, he finally returns, only to find that a great conspiracy has surfaced and the fate of the Master and his disciples has been rewritten.",
      "thumbnail": "https://episodes.metahub.space/tt27657838/0/1/w780.jpg",
      "moviedb_id": 4119191
    },
    {
      "id": "tt27657838:0:2",
      "title": "The Westward: The Fantasy Cave",
      "season": 0,
      "episode": 2,
      "number": 2,
      "released": "2022-08-19T00:00:00.000Z",
      "overview": "The westbound team went to the other side to get the eternal fire. When they passed through Renjian Town, they were attracted by the fantastic and beautiful scenery of Qiongqi Cave and accidentally entered the cave. As a result, they accidentally learned the conspiracy of the great demon Bai-Eyed Demon King of Qiongqi Cave. In order to prevent the shocking disaster that is about to invade the entire monster road, master and disciples fight together. When Sun Wukong is controlled by his mind and transforms into a giant ape, how will the Westbound team make a comeback in the face of unprecedented desperation and crisis?",
      "thumbnail": "https://episodes.metahub.space/tt27657838/0/2/w780.jpg",
      "moviedb_id": 4119196
    },
    {
      "id": "tt27657838:0:3",
      "title": "The Westward: The Kingdom of Shadow",
      "season": 0,
      "episode": 3,
      "number": 3,
      "released": "2023-01-18T00:00:00.000Z",
      "overview": "The film tells the story of a westbound team composed of Tang Sanzang, Sun Wukong, Zhu Bajie, Sha Wujing, and Ao Xue who went to the other world to obtain the eternal fire. On the way, they encountered a mysterious \"Holy City of Bliss\". The team members fell into the illusion one after another, and Tang Sanzang was also unable to extricate himself from the illusion. Finally, with the help of his apprentice, he defeated his inner demons and defeated the Lord of the Shadow Magic City.",
      "thumbnail": "https://episodes.metahub.space/tt27657838/0/3/w780.jpg",
      "moviedb_id": 4172623
    },
