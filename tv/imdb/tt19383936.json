      "moviedb_id": 3984773
    },
    {
      "id": "tt19383936:1:6",
      "title": "Fall (Two Days at the End of November 1963)",
      "season": 1,
      "episode": 6,
      "number": 6,
      "released": "2022-11-04T00:00:00.000Z",
      "overview": "Curlers are being spat out at the busy Carmen factory, but for Frans there is not much to do. That's why he takes a job from the fashion photographer Benjamin in Copenhagen, where he has to do the hair of a French film star.",
