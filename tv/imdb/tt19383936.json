    {
      "id": "tt19383936:1:1",
      "title": "Summer (August 1963)",
      "season": 1,
      "episode": 1,
      "number": 1,
      "released": "2022-09-30T00:00:00.000Z",
      "overview": "Axel Byvang has an idea to work his way up from poor conditions: a device that can give modern women a smart hairstyle in 10 minutes. But the first experiments in a humble basement room go horribly wrong.",
