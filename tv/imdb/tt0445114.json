    {
      "id": "tt0445114:1:5",
      "title": "Samuel L. Jackson",
      "season": 1,
      "episode": 5,
      "number": 5,
      "released": "2005-08-18T00:00:00.000Z",
      "overview": "Andy and Maggie are this time working on an action movie starring Samuel L Jackson. Andy finds himself cornered into a friendship with an incredibly over-friendly middle-aged Welshman also working on the set. Maggie finds herself attracted to black actor Danny on set, but isn't sure how to talk to him because of his race.",
