  "videos": [
    {
      "id": "tt0465682:1:1",
      "title": "Episode 1",
      "season": 1,
      "episode": 1,
      "number": 1,
      "released": "2006-10-15T00:00:00.000Z",
      "overview": "A mysterious letter, a trip to Capri and an unexpected inheritance: this is just the beginning of the adventure of Vittoria, a twenty-six-year-old psychologist from the province of Milan, who suddenly finds her perfect life completely turned upside down.",
      "thumbnail": "https://episodes.metahub.space/tt0465682/1/1/w780.jpg",
      "moviedb_id": 1796502
    },
    {
      "id": "tt0465682:1:2",
      "title": "Episode 2",
      "season": 1,
      "episode": 2,
      "number": 2,
      "released": "2006-10-16T00:00:00.000Z",
      "overview": "Once in Capri, Vittoria meets the brothers Umberto and Massimo Galiano, with whom she will have to share her inheritance. Umberto is the most celebrated playboy on the island and is not immune to the charm of the young Milanese.",
      "thumbnail": "https://episodes.metahub.space/tt0465682/1/2/w780.jpg",
      "moviedb_id": 2041673
    },
    {
      "id": "tt0465682:1:3",
      "title": "Episode 3",
      "season": 1,
      "episode": 3,
      "number": 3,
      "released": "2006-10-16T00:00:01.000Z",
      "overview": "Vittoria discovers that she was adopted: her real mother is called Angela and was forced to flee Capri. In the meantime, Domenico Scapece begins to behave as if the villa were already his and the young psychologist realizes that, perhaps, selling it is not the best choice.",
      "thumbnail": "https://episodes.metahub.space/tt0465682/1/3/w780.jpg",
      "moviedb_id": 2041674
    },
    {
      "id": "tt0465682:1:4",
      "title": "Episode 4",
      "season": 1,
      "episode": 4,
      "number": 4,
      "released": "2006-10-16T00:00:02.000Z",
      "overview": "Vittoria has decided not to sell her share of the inheritance, making Gennarino, Umberto and Reginella's family happy but unleashing Massimo's wrath, worried about the debts weighing on the villa.",
      "thumbnail": "https://episodes.metahub.space/tt0465682/1/4/w780.jpg",
      "moviedb_id": 2041675
    },
    {
      "id": "tt0465682:1:5",
      "title": "Episode 5",
      "season": 1,
      "episode": 5,
      "number": 5,
      "released": "2006-10-22T00:00:00.000Z",
      "overview": "While Vittoria investigates Reginella's past, the elderly cook organizes a big dinner at Villa Isabella, triggering Scapece's reaction, who reports the restaurant's activity to the Carabinieri.",
      "thumbnail": "https://episodes.metahub.space/tt0465682/1/5/w780.jpg",
      "moviedb_id": 2041676
    },
    {
      "id": "tt0465682:1:6",
      "title": "Episode 6",
      "season": 1,
      "episode": 6,
      "number": 6,
      "released": "2006-10-22T00:00:01.000Z",
      "overview": "The relationship between Massimo and Umberto is increasingly tense and Vittoria's presence makes the climate even more incandescent. In the meantime, Massimo's son with his deceased wife arrives in Capri. The man would like to move to Rome, where the child will grow up with his grandparents, but Umberto tries to convince him that the boy should grow up on the island, with his father.",
      "thumbnail": "https://episodes.metahub.space/tt0465682/1/6/w780.jpg",
      "moviedb_id": 2041677
    },
    {
      "id": "tt0465682:1:7",
      "title": "Episode 7",
      "season": 1,
      "episode": 7,
      "number": 7,
      "released": "2006-10-29T00:00:00.000Z",
      "overview": "Reginella can't believe that Vittoria is her niece and, angry at what she considers a lie, moves to Gennarino's house. Meanwhile, an American tourist named Jane, an old conquest of Umberto, arrives at the Scapece Hotel. Carolina begins to hope that this presence could upset the relationship between Galiano and Vittoria.",
      "thumbnail": "https://episodes.metahub.space/tt0465682/1/7/w780.jpg",
      "moviedb_id": 2041678
    },
