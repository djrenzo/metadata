    {
      "id": "tt6428718:1:1",
      "title": "Episode 1",
      "season": 1,
      "episode": 1,
      "number": 1,
      "released": "2013-03-18T00:00:00.000Z",
      "overview": "Being the son of a concubine, Jun is mistreated by his older half-brother and dismissed from his father's birthday feast. Jun dreams of being a great general that fights barbarians, just like his father.",
      "thumbnail": "https://episodes.metahub.space/tt6428718/1/1/w780.jpg",
      "moviedb_id": 945016
    },
    {
      "id": "tt6428718:1:2",
      "title": "Episode 2",
      "season": 1,
      "episode": 2,
      "number": 2,
      "released": "2013-03-19T00:00:00.000Z",
      "overview": "Everyone frantically searches for Jun as he was left out in the bitter cold as punishment by Seok. Jun gets saved by an ex-royal physician and meets his young daughter, Mi-hyeon.",
      "thumbnail": "https://episodes.metahub.space/tt6428718/1/2/w780.jpg",
      "moviedb_id": 945018
    },
    {
      "id": "tt6428718:1:3",
      "title": "Episode 3",
      "season": 1,
      "episode": 3,
      "number": 3,
      "released": "2013-03-20T00:00:00.000Z",
      "overview": "Jun and Mi-hyeon are captured by the barbarians and about to be sold as slaves. The barbarians propose a trade to General Heo but he is forced by the Lordship to decline it.",
      "thumbnail": "https://episodes.metahub.space/tt6428718/1/3/w780.jpg",
      "moviedb_id": 945017
    },
    {
      "id": "tt6428718:1:4",
      "title": "Episode 4",
      "season": 1,
      "episode": 4,
      "number": 4,
      "released": "2013-03-21T00:00:00.000Z",
      "overview": "Jun has now dipped into illegal trading of medicinal ingredients. His position as a concubine's son continues to haunt him in the present.",
      "thumbnail": "https://episodes.metahub.space/tt6428718/1/4/w780.jpg",
      "moviedb_id": 945020
    },
    {
      "id": "tt6428718:1:5",
      "title": "Episode 5",
      "season": 1,
      "episode": 5,
      "number": 5,
      "released": "2013-03-22T00:00:00.000Z",
      "overview": "While the officers are in search for Lee Jeong-chan and his daughter, Da-hee, he passes away. Heojun decides to conduct illegal trade to leave Yongcheon and help Da-hee escape.",
      "thumbnail": "https://episodes.metahub.space/tt6428718/1/5/w780.jpg",
      "moviedb_id": 945019
    },
    {
      "id": "tt6428718:1:6",
      "title": "Episode 6",
