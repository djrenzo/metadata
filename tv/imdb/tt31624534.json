    {
      "id": "tt31624534:1:1",
      "title": "The Promised Moon",
      "season": 1,
      "episode": 1,
      "number": 1,
      "released": "2024-01-07T00:00:00.000Z",
      "overview": "A young and bright girl Mahiro in Japan's Heian period grows up in a poor, minor aristocratic family. Her father's only wish is that she were a boy, so that Mahiro could put her talent to use. Mahiro faces a major loss, however nobody could guess that one day, this little girl would become Murasaki Shikibu.",
      "thumbnail": "https://episodes.metahub.space/tt31624534/1/1/w780.jpg",
      "moviedb_id": 4931607
    },
    {
      "id": "tt31624534:1:2",
      "title": "Encounter",
      "season": 1,
      "episode": 2,
      "number": 2,
      "released": "2024-01-14T00:00:00.000Z",
      "overview": "6 years after her mothers death and Mahiro, now a young woman, comes of age. Meanwhile in the Imperial palace, Akiko, who has given the Emperor a son, has become forgotten. Until one day, the Emperor reveals how he truly feels. Akiko's father hatches a plan for his abdication, and Mahiro has a fateful encounter.",
      "thumbnail": "https://episodes.metahub.space/tt31624534/1/2/w780.jpg",
      "moviedb_id": 5057185
    },
