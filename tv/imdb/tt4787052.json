  "videos": [
    {
      "id": "tt4787052:1:1",
      "title": "Episode 1",
      "season": 1,
      "episode": 1,
      "number": 1,
      "released": "2015-06-19T00:00:00.000Z",
      "overview": "Defne, who gets into trouble because of her brother, gets stuck in debt and becomes helpless. Just when she doesn't know what to do, a miracle knocks on her door: Neriman, the queen of intrigues, and her husband Necmi are looking for a girl to get close to their nephew Ömer and make him fall in love with her. Their aim is to marry Ömer and in return, he will be placed in the mansion promised by Necmi's father, Hulusi Bey. Neriman finds Defne and will prepare her for Ömer and teach her everything he knows. Ömer is a very impressive but also difficult man.",
      "thumbnail": "https://episodes.metahub.space/tt4787052/1/1/w780.jpg",
      "moviedb_id": 1095469
    },
    {
      "id": "tt4787052:1:2",
      "title": "Episode 2",
      "season": 1,
      "episode": 2,
      "number": 2,
      "released": "2015-06-26T00:00:00.000Z",
      "overview": "All kinds of misfortunes await Defne, who will be shooting a catalog on a beautiful beach for the first time in her life. Neriman advises Defne to take full advantage of this extremely romantic opportunity consisting of sea, sun and sand. However, things get complicated when Defne, far from stealing Ömer's heart, ruins the entire shoot with her clumsiness. Neriman's collaborator Sinan comes to her rescue. Ömer, on the other hand, cannot understand his feelings for Defne. This naive and clumsy girl is like an angel of goodness descended from space. On the other hand, Yasemin, who notices the rapprochement between Ömer and Defne, rolls up her sleeves to stop this situation.",
      "thumbnail": "https://episodes.metahub.space/tt4787052/1/2/w780.jpg",
      "moviedb_id": 1095471
    },
    {
      "id": "tt4787052:1:3",
      "title": "Episode 3",
      "season": 1,
      "episode": 3,
      "number": 3,
      "released": "2015-07-03T00:00:00.000Z",
      "overview": "Preparations have begun for the upcoming big fashion meeting. This big day quickly turns into an emotional occasion for everyone. While Yasemin plans to steal Ömer's heart on this special night, Sinan looks for ways to get closer to Yasemin. All plans change when Ömer decides to attend the invitation with Defne at the last minute. Neriman prepares Defne feverishly to be the star of the night. However, this big night is full of even bigger surprises in its finale. A big shock awaits everyone.",
      "thumbnail": "https://episodes.metahub.space/tt4787052/1/3/w780.jpg",
      "moviedb_id": 1095472
    },
    {
      "id": "tt4787052:1:4",
      "title": "Episode 4",
      "season": 1,
      "episode": 4,
      "number": 4,
      "released": "2015-07-10T00:00:00.000Z",
      "overview": "Defne, who became a thief in the company because of Yasemin, cannot digest this. On the other hand, Ömer is very confused. Although his feelings say that Defne did not commit this theft, the evidence shows the opposite. Yasemin watches this view with pleasure and is intoxicated with victory. However, Neriman has a genius plan that will reveal Yasemin's true face. He has no intention of leaving the square to him. Ömer and Defne, unaware of the war between Neriman and Yasemin, will find themselves in an unexpected love game.",
      "thumbnail": "https://episodes.metahub.space/tt4787052/1/4/w780.jpg",
      "moviedb_id": 1095473
    },
